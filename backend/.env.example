# Copy to .env and fill in real values. Never commit the real .env file.

# OpenAI API key used to clean resumes.
OPENAI_API_KEY=

# Port the Express server listens on.
PORT=5000

# Neon Postgres connection string.
DATABASE_URL=

# Secret used to sign the anonymous session cookie that owns each resume.
# Required in production - if unset, a random secret is generated per process
# restart, which invalidates every existing session cookie on deploy/restart.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Optional: enables distributed rate limiting via Upstash Redis. If unset, the
# app falls back to a local in-memory limiter (fine for a single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Origin of the deployed frontend, added to the CORS allowlist.
FRONTEND_URL=

# development | production - controls cookie Secure/SameSite flags, so
# production MUST be served over HTTPS.
NODE_ENV=development
